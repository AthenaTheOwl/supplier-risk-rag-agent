{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supplier-risk-rag-agent.local/roles/science.eval-curator/output.schema.json",
  "title": "EvalCuratorOutput",
  "description": "Eval-suite update artifact: the config_patch against eval_suites/<suite>.yaml plus the matching DEC-EVL memo and the baseline-delta report.",
  "type": "object",
  "required": ["suite", "change_kind", "decision_path", "baseline_scores", "candidate_scores", "decision"],
  "additionalProperties": false,
  "properties": {
    "suite": {
      "type": "string",
      "enum": [
        "retrieval_quality",
        "citation_faithfulness",
        "supplier_risk_questions",
        "refusal_cases"
      ]
    },
    "change_kind": {
      "type": "string",
      "enum": ["case_added", "threshold_adjusted", "judge_prompt_updated", "reference_label_corrected"]
    },
    "decision_path": {"type": "string"},
    "baseline_scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recall_at_5": {"type": "number", "minimum": 0, "maximum": 1},
        "citation_faithfulness": {"type": "number", "minimum": 0, "maximum": 1},
        "answer_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "refusal_precision": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "candidate_scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recall_at_5": {"type": "number", "minimum": 0, "maximum": 1},
        "citation_faithfulness": {"type": "number", "minimum": 0, "maximum": 1},
        "answer_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "refusal_precision": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "deltas": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "decision": {"type": "string", "enum": ["approved", "blocked", "needs_human_signoff"]},
    "report_path": {"type": "string"}
  }
}
